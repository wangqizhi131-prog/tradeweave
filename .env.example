# PayPal Developer Dashboard > Apps & Credentials > Sandbox credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Any OpenAI-compatible chat-completions provider can be used.
# Keep the key server-side; never put it in frontend code.
# For an OpenRouter free-only setup, use https://openrouter.ai/api/v1/chat/completions
# and model openrouter/free or a specific model ID ending in :free.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
# Some compatible providers (including DashScope) use max_tokens.
# Allowed values: max_completion_tokens (default), max_tokens.
AI_TOKEN_PARAMETER=max_completion_tokens
PORT=4173
# Optional persistent data locations. Paths use forward slashes on Windows.
# DATA_DIR=C:/path/to/private-data
# MEDIA_DIR=C:/path/to/media
# BACKUP_DIR=C:/path/to/private-backups
# Optional remote SQLite-compatible Turso database for hosted deployments.
# Configure both values to retain catalog, tickets and orders across host restarts.
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=
